{
  "name": "classpilot",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/api",
    "dev:mobile": "npm run start --workspace apps/mobile",
    "build": "npm run build --workspace apps/api",
    "typecheck": "npm run typecheck --workspace apps/api && npm run typecheck --workspace apps/mobile",
    "test": "npm run test --workspace apps/mobile"
  }
}
