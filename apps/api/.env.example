DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/classpilot?schema=public"
PORT=3000
HOST=0.0.0.0
# Required in production: a long random string (at least 32 characters), e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long sign-ins last before the app asks to sign in again.
TOKEN_TTL=30d
# Comma-separated browser origins allowed to call the API (Expo web). Native apps don't need this.
# CORS_ORIGINS=http://localhost:8081
# Password reset emails. Without RESEND_API_KEY the email (including the code) is printed to the server log.
# RESEND_API_KEY=
# MAIL_FROM="ClassPilot <no-reply@yourdomain.com>"
# Error monitoring (also receives errors reported by the app). Disabled when unset.
# SENTRY_DSN=
