{
  "expo": {
    "name": "ClassPilot",
    "slug": "classpilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.teacherplanner.mobile"
    },
    "android": {
      "package": "com.teacherplanner.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": [
            "en",
            "fr",
            "ar"
          ]
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "classpilot",
    "owner": "khaledxdls",
    "extra": {
      "eas": {
        "projectId": "f3fee8ea-bca1-46ff-9433-bb86e93e7326"
      }
    }
  }
}
